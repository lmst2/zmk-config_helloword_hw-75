config HW75_USB_COMM
	bool
	default y
	select HW75_USB_COMM_FEATURE_RGB
	select HW75_USB_COMM_FEATURE_DEBUG_LOG

if HW75_USB_COMM

config HW75_USB_COMM_THREAD_STACK_SIZE
	int
	default 1024

config HW75_USB_COMM_MAX_TX_MESSAGE_SIZE
	int
	default 256

config HW75_USB_COMM_MAX_RX_MESSAGE_SIZE
	int
	default 64

endif # HW75_USB_COMM
